# Canonical site URL. The apex jsonforge.com is canonical (www and
# json.bkjlabs.com redirect to it). Must match the primary domain in Vercel.
NEXT_PUBLIC_SITE_URL=https://jsonforge.com

# Google Search Console verification token (HTML-tag method). Paste the value
# from the <meta name="google-site-verification" content="..."> that GSC shows.
# Only the token, not the whole tag. Leave blank if verifying via DNS or GA.
GOOGLE_SITE_VERIFICATION=

# Contact form (Resend). All three are required for /api/contact to send.
# Verify the bkjlabs.com domain in Resend, then use its addresses below.

# Resend API key: https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Where contact-form messages are delivered.
CONTACT_TO_EMAIL=contact@bkjlabs.com

# Verified Resend sender (on bkjlabs.com). This is the From; the visitor's address
# is only ever used as Reply-To, which is what prevents header injection.
CONTACT_FROM_EMAIL="JSON Forge <noreply@bkjlabs.com>"
